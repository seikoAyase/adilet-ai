# Project Configuration
PROJECT_NAME="KZ Legal RAG"
API_V1_STR="/api/v1"
DEBUG=true

# PostgreSQL + pgvector
POSTGRES_USER=kz_legal_user
POSTGRES_PASSWORD=kz_legal_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=kz_legal_db

# Embedding settings (Open-Source multilingual model)
EMBEDDING_DIMENSION=384
OPENSOURCE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Google Gemini LLM API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
